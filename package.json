{
  "name": "engineering-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && npm run pages:config:check",
    "build": "astro build && pagefind --site dist",
    "pages:config": "node scripts/generate-pages-config.mjs",
    "pages:config:check": "node scripts/generate-pages-config.mjs --check",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.4",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.4.10",
    "mermaid": "^12.3.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "pagefind": "^1.6.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
