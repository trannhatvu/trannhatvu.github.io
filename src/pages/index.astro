---
const destination = '/en/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={new URL(destination, Astro.site)} />
    <meta name="robots" content="noindex" />
    <title>Raini’s Petit Coin — A little corner for curious minds</title>
  </head>
  <body><p>Continue to <a href={destination}>Raini’s Petit Coin</a>.</p></body>
</html>
