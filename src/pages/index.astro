---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import Portrait from '../components/Portrait.astro';
import { published, site, tagSlug, text } from '../lib/site';
const entries = await published();
const writing = entries.filter(entry => entry.data.kind !== 'note');
const notes = entries.filter(entry => entry.data.kind === 'note');
const topics = [...new Set(entries.flatMap(entry => entry.data.tags))].sort();
---
<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{text.eyebrow}</p>
      <h1>{text.intro.split('\n')[0]}<br /><span>{text.intro.split('\n')[1]}</span></h1>
      <p class="hero-description">{text.description}</p>
      <a class="text-link" href="/writing/">{text.browse} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-aside">
      <div class="profile-stamp"><Portrait /><div><strong>{site.name}</strong><span>Learning in public</span></div></div>
      <div class="code-note" aria-hidden="true">
        <div class="code-note-heading"><span></span><span></span><span></span><small>notebook.sh</small></div>
        <pre><code><span class="code-comment"># a small feedback loop</span>{'\n'}<span class="code-blue">while</span> curious; <span class="code-blue">do</span>{'\n'}  learn{'\n'}  build{'\n'}  write{'\n'}<span class="code-blue">done</span><span class="code-cursor">_</span></code></pre>
        <span class="code-note-foot">ideas → experiments → notes</span>
      </div>
    </div>
  </section>
  <section class="topics-strip" aria-label={text.topics}>
    <span class="eyebrow">{text.topics}</span>
    <div class="topic-links">{topics.map(tag => <a href={`/tags/${tagSlug(tag)}/`}>{tag}<span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="writing-section">
    <div class="section-heading"><h2><span class="section-index">01 /</span>{text.latest}</h2><a class="subtle-link" href="/writing/">{text.allWriting} <span aria-hidden="true">→</span></a></div>
    <div class="entry-list">{writing.length ? writing.slice(0, 3).map(entry => <EntryCard entry={entry} />) : <p class="empty-state">{text.empty}</p>}</div>
  </section>
  <section class="notes-section">
    <div class="section-heading"><h2><span class="section-index">02 /</span>{text.recentNotes}</h2><a class="subtle-link" href="/notes/">{text.allNotes} <span aria-hidden="true">→</span></a></div>
    <div class="notes-grid">{notes.length ? notes.slice(0, 2).map(entry => <EntryCard entry={entry} compact />) : <p class="empty-state">{text.empty}</p>}</div>
  </section>
</Base>
