---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { dateLabel, entryUrl, published, readingTime, tagSlug, text } from '../../../lib/site';
export async function getStaticPaths() {
  return (await published()).map(entry => ({
    params: { lang: entry.data.lang, section: entry.data.kind === 'note' ? 'notes' : 'writing', slug: entry.id.split('/').at(-1) },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { lang } = entry.data;
const t = text[lang];
const translation = (await published()).find(other => other.data.lang !== lang && other.data.translationKey === entry.data.translationKey);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description} article alternate={translation ? entryUrl(translation) : undefined}>
  <a class="subtle-link article-back" href={`/${lang}/${entry.data.kind === 'note' ? 'notes' : 'writing'}/`}>← {entry.data.kind === 'note' ? t.allNotes : t.back}</a>
  <article class="article-shell" data-pagefind-body data-copy={t.copy} data-copied={t.copied} data-copy-error={t.copyError} data-diagram-error={t.diagramError}>
    <header class="article-heading">
      <p class="eyebrow">{entry.data.kind === 'note' ? t.note : entry.data.kind === 'article' ? t.article : t.tutorial}</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="article-description" data-pagefind-meta="description">{entry.data.description}</p>
      <div class="entry-meta"><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date, lang)}</time><span aria-hidden="true">/</span><span>{readingTime(entry)} {t.minute}</span></div>
      <div class="tags">{entry.data.tags.map(tag => <a href={`/${lang}/tags/${tagSlug(tag)}/`}>{tag}</a>)}</div>
      {translation && <a class="translation-link" href={entryUrl(translation)} lang={translation.data.lang} hreflang={translation.data.lang}>{t.translated} <span aria-hidden="true">↗</span></a>}
    </header>
    <div class="article-layout">
      <div class="prose">
        {entry.data.starter && <aside class="callout starter-callout" data-pagefind-ignore>{t.starter}</aside>}
        <Content />
        <p class="copy-status visually-hidden" role="status" aria-live="polite" data-pagefind-ignore></p>
      </div>
      {toc.length > 0 && <aside class="toc" data-pagefind-ignore><details open><summary>{t.toc}</summary><ol>{toc.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details></aside>}
    </div>
  </article>
  <script>
    import { setupArticle } from '../../../scripts/article';
    setupArticle();
  </script>
</Base>
