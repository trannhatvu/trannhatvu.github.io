---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import Portrait from '../../components/Portrait.astro';
import { languages, published, site, tagSlug, text, type Language } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = text[lang];
const entries = await published(lang);
const tutorials = entries.filter(entry => entry.data.kind === 'tutorial');
const notes = entries.filter(entry => entry.data.kind === 'note');
const topics = [...new Set(entries.flatMap(entry => entry.data.tags))].sort();
---
<Base lang={lang} alternate={`/${lang === 'en' ? 'vi' : 'en'}/`}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{t.eyebrow}</p>
      <h1>{t.intro.split('\n')[0]}<br /><span>{t.intro.split('\n')[1]}</span></h1>
      <p class="hero-description">{t.description}</p>
      <a class="text-link" href={`/${lang}/writing/`}>{t.browse} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-aside">
      <div class="profile-stamp"><Portrait lang={lang} /><div><strong>{site.name}</strong><span>{lang === 'en' ? 'Learning in public' : 'Học hỏi và chia sẻ'}</span></div></div>
      <div class="code-note" aria-hidden="true">
        <div class="code-note-heading"><span></span><span></span><span></span><small>notebook.sh</small></div>
        <pre><code><span class="code-comment"># a small feedback loop</span>{'\n'}<span class="code-blue">while</span> curious; <span class="code-blue">do</span>{'\n'}  learn{'\n'}  build{'\n'}  write{'\n'}<span class="code-blue">done</span><span class="code-cursor">_</span></code></pre>
        <span class="code-note-foot">ideas → experiments → notes</span>
      </div>
    </div>
  </section>
  <section class="topics-strip" aria-label={t.topics}>
    <span class="eyebrow">{t.topics}</span>
    <div class="topic-links">{topics.map(tag => <a href={`/${lang}/tags/${tagSlug(tag)}/`}>{tag}<span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="writing-section">
    <div class="section-heading"><h2><span class="section-index">01 /</span>{t.latest}</h2><a class="subtle-link" href={`/${lang}/writing/`}>{t.allWriting} <span aria-hidden="true">→</span></a></div>
    <div class="entry-list">{tutorials.length ? tutorials.slice(0, 3).map(entry => <EntryCard entry={entry} />) : <p class="empty-state">{t.empty}</p>}</div>
  </section>
  <section class="notes-section">
    <div class="section-heading"><h2><span class="section-index">02 /</span>{t.recentNotes}</h2><a class="subtle-link" href={`/${lang}/notes/`}>{t.allNotes} <span aria-hidden="true">→</span></a></div>
    <div class="notes-grid">{notes.length ? notes.slice(0, 2).map(entry => <EntryCard entry={entry} compact />) : <p class="empty-state">{t.empty}</p>}</div>
  </section>
</Base>
