---
import Base from '../../../layouts/Base.astro';
import EntryCard from '../../../components/EntryCard.astro';
import { languages, published, tagSlug, text, type Language } from '../../../lib/site';
export async function getStaticPaths() {
  const entries = await published();
  return languages.flatMap(lang => [...new Set(entries.filter(entry => entry.data.lang === lang).flatMap(entry => entry.data.tags))]
    .map(tag => ({ params: { lang, tag: tagSlug(tag) }, props: { tag } })));
}
const lang = Astro.params.lang as Language;
const { tag } = Astro.props;
const t = text[lang];
const entries = (await published(lang)).filter(entry => entry.data.tags.includes(tag));
const other = lang === 'en' ? 'vi' : 'en';
const hasOther = (await published(other)).some(entry => entry.data.tags.some(item => tagSlug(item) === tagSlug(tag)));
---
<Base lang={lang} title={`${t.tagged}: ${tag}`} alternate={hasOther ? `/${other}/tags/${tagSlug(tag)}/` : undefined}>
  <header class="page-heading"><p class="eyebrow">{t.tagged}</p><h1>{tag}<span class="accent">.</span></h1><p>{entries.length} {lang === 'en' ? 'entries in the notebook' : 'bài trong sổ tay'}</p></header>
  <a class="subtle-link" href={`/${lang}/writing/`}>← {t.allWriting}</a>
  <div class="entry-list tag-entries">{entries.map(entry => <EntryCard entry={entry} />)}</div>
</Base>
