---
import Base from '../../layouts/Base.astro';
import { languages, text, type Language } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = text[lang];
---
<Base lang={lang} title={t.search} alternate={`/${lang === 'en' ? 'vi' : 'en'}/search/`}>
  <header class="page-heading"><p class="eyebrow">THE NOTEBOOK / {t.search}</p><h1>{t.search}<span class="accent">.</span></h1><p>{t.searchDescription}</p></header>
  <section class="search-panel" data-search data-loading={t.searchLoading} data-empty={t.searchEmpty} data-error={t.searchError} data-results={t.results} data-dev={import.meta.env.DEV ? t.searchDev : undefined}>
    <label for="search-input" class="eyebrow">{t.searchLabel}</label>
    <input id="search-input" type="search" placeholder={t.searchPlaceholder} autocomplete="off" aria-describedby="search-hint" />
    <p id="search-hint" class="search-hint">{t.searchHint}</p>
    <p class="search-status" role="status" aria-live="polite"></p>
    <ul class="search-results"></ul>
    <noscript><p>{lang === 'en' ? 'Search needs JavaScript. You can still browse all writing and topics.' : 'Tìm kiếm cần JavaScript. Bạn vẫn có thể xem bài viết và chủ đề.'}</p><a href={`/${lang}/writing/`}>{t.allWriting}</a></noscript>
  </section>
  <script>
    import { setupSearch } from '../../scripts/search';
    setupSearch();
  </script>
</Base>
