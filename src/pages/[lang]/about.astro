---
import Base from '../../layouts/Base.astro';
import Portrait from '../../components/Portrait.astro';
import { languages, site, text, type Language } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = text[lang];
---
<Base lang={lang} title={t.about} alternate={`/${lang === 'en' ? 'vi' : 'en'}/about/`}>
  <header class="page-heading"><p class="eyebrow">{t.about} / {site.name}</p><h1>{t.aboutTitle}</h1><p>{t.aboutLead}</p></header>
  <section class="about-layout">
    <Portrait lang={lang} large />
    <div class="prose"><p>{t.aboutBody}</p><p>{t.aboutSecond}</p><aside class="callout"><strong>{t.aboutPlaceholder}</strong><p>{t.aboutInstruction}</p></aside><a class="text-link" href={`/${lang}/writing/`}>{t.browse} ↗</a></div>
  </section>
</Base>
