---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateLabel, published, readingTime, tagSlug, text } from '../../lib/site';
export async function getStaticPaths() {
  return (await published()).map(entry => ({
    params: { section: entry.data.kind === 'note' ? 'notes' : 'writing', slug: entry.id.split('/').at(-1) },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base title={entry.data.title} description={entry.data.description} lang={entry.data.lang} article>
  <a class="subtle-link article-back" href={`/${entry.data.kind === 'note' ? 'notes' : 'writing'}/`}>← {entry.data.kind === 'note' ? text.allNotes : text.back}</a>
  <article class="article-shell" data-pagefind-body data-copy={text.copy} data-copied={text.copied} data-copy-error={text.copyError} data-diagram-error={text.diagramError}>
    <header class="article-heading">
      <p class="eyebrow">{entry.data.kind === 'note' ? text.note : entry.data.kind === 'article' ? text.article : text.tutorial}</p>
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="article-description" data-pagefind-meta="description">{entry.data.description}</p>
      <div class="entry-meta"><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date, entry.data.lang)}</time><span aria-hidden="true">/</span><span>{readingTime(entry)} {text.minute}</span></div>
      <div class="tags">{entry.data.tags.map(tag => <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}</div>
    </header>
    <div class="article-layout">
      <div class="prose">
        {entry.data.starter && <aside class="callout starter-callout" data-pagefind-ignore>{text.starter}</aside>}
        <Content />
        <p class="copy-status visually-hidden" role="status" aria-live="polite" data-pagefind-ignore></p>
      </div>
      {toc.length > 0 && <aside class="toc" data-pagefind-ignore><details open><summary>{text.toc}</summary><ol>{toc.map(heading => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details></aside>}
    </div>
  </article>
  <section class="discussion" aria-labelledby="discussion-heading" data-pagefind-ignore>
    <h2 id="discussion-heading">{entry.data.lang === 'vi' ? 'Bình luận' : 'Discussion'}</h2>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo="trannhatvu/trannhatvu.github.io"
      data-repo-id="R_kgDOVql-mw"
      data-category="Announcements"
      data-category-id="DIC_kwDOVql-m84DK6nK"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang={entry.data.lang}
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </section>
  <script>
    import { setupArticle, setupDiscussionTheme } from '../../scripts/article';
    setupArticle();
    setupDiscussionTheme();
  </script>
</Base>
