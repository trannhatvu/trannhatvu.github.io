---
import { site, text, type Language } from '../lib/site';
interface Props { lang: Language; large?: boolean }
const { lang, large = false } = Astro.props;
---
<div class:list={['portrait', { 'portrait-large': large }]}>
  {site.portrait
    ? <img src={site.portrait} alt={site.name} width="160" height="160" />
    : <span role="img" aria-label={text[lang].photo}>R<span class="portrait-dot" aria-hidden="true"></span></span>}
</div>
